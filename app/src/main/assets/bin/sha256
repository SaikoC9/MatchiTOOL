#!/system/bin/sh
# MatchiTOOL helper "sha256": prints a SHA-256 hash (plugins call it by name from the bin folder).
# Prints the SHA-256 of its first argument as lowercase hex, or of standard input when no argument is given. Uses the system's sha256sum (toybox).
H=/system/bin/sha256sum
[ -x "$H" ] || H=$(command -v sha256sum 2>/dev/null)
[ -n "$H" ] || { echo "sha256: sha256sum not found" >&2; exit 127; }
if [ "$#" -gt 0 ]; then printf '%s' "$1" | "$H"; else "$H"; fi | cut -d' ' -f1
