#!/system/bin/sh
# MatchiTOOL helper "sha256": prints a SHA-256 hash as lowercase hex (plugins call it by name from the app's files folder).
# One argument that is a readable file: the hash of that FILE'S CONTENT (the same value "sha256sum FILE" prints). Any other argument: the hash of that text.
# No argument: the hash of standard input. Uses the system's sha256sum (toybox).
H=/system/bin/sha256sum
[ -x "$H" ] || H=$(command -v sha256sum 2>/dev/null)
[ -n "$H" ] || { echo "sha256: sha256sum not found" >&2; exit 127; }
if [ "$#" -gt 0 ]; then
  if [ -f "$1" ] && [ -r "$1" ]; then "$H" < "$1"; else printf '%s' "$1" | "$H"; fi
else "$H"; fi | cut -d' ' -f1
