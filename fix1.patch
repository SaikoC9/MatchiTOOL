   async function radioCycle(ui) {
     const log = (ui && ui.log) || (() => {}), toast = (ui && ui.toast) || (() => {});
     log('> Radio restart (AT+SFUN=5 radio off, then AT+SFUN=4 radio on, SIM slots 0 and 1, as UFI-TOOLS does; runs on the device)');
     let text = '', lost = false;
